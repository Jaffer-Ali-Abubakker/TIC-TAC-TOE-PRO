# -----------------------------------------------------------------------------
# Tic-Tac-Toe Pro - environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:
#   copy .env.example .env
#
# EVERY VITE_ VARIABLE IS PUBLIC. It is bundled into the JavaScript that is
# served to every visitor. Never put a service role key, a database password
# or any other privileged secret in this file.
# -----------------------------------------------------------------------------

# Supabase project URL - Dashboard -> Project Settings -> API
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (formerly the "anon" key).
# Dashboard -> Project Settings -> API -> Project API keys.
# This key is public by design; access is controlled by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=

# The public base URL of this application. It is used to build invite links.
#
# OPTIONAL. Leave it EMPTY and the app uses the address the player is
# currently on (window.location.origin), which is always correct - including
# on Vercel preview deployments. Set it only if you want to pin the domain,
# for example:
#   VITE_APP_URL=https://tic-tac-toe-pro.vercel.app
# Never use http://localhost here.
VITE_APP_URL=
